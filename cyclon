#!/usr/bin/env python3
"""
Cyclon: Generic script to automate tasks using opencode in a loop.

This script reads a plan (checklist) and prompt from markdown files,
executes opencode with the combined prompt in a loop, handling errors and retries.
Uses a lock file (.cyclon.lock) to ensure only one instance runs at a time.
"""

import os
import sys
import argparse
import subprocess
import time
import json

class Config:
    """Handles loading and storing configuration from config.json files."""

    def __init__(self):
        """Initialize the Config object and load settings."""
        self.load()

    def load(self):
        """Load configuration values from config.json files."""
        script_dir = os.path.dirname(os.path.abspath(__file__))
        default_config_path = os.path.join(script_dir, 'config.json')
        local_config_path = os.path.join(os.getcwd(), '.cyclon.config.json')

        # Load default config
        with open(default_config_path, 'r') as f:
            config = json.load(f)

        # Merge local config if exists
        if os.path.exists(local_config_path):
            with open(local_config_path, 'r') as f:
                local_config = json.load(f)
            config.update(local_config)

        self.model = config.get('model', 'opencode/grok-code')
        self.default_plan = '.cyclon.plan.md'
        self.default_prompt = '.cyclon.prompt.md'
        self.exception_strings = config.get('exceptionStrings', [])
        self.sleep_duration = config.get('sleep', 10)
        self.timeout = config.get('timeout', 3600)

class ArgumentParser:
    """Handles command-line argument parsing."""

    def __init__(self, config):
        """Initialize with config object to get default values."""
        self.config = config

    def parse(self):
        """Parse command-line arguments and return parsed args."""
        parser = argparse.ArgumentParser(description='Generic opencode automation script.')
        parser.add_argument('--plan', type=str, default=self.config.default_plan, help='Path to the plan file')
        parser.add_argument('--prompt', type=str, default=self.config.default_prompt, help='Path to the prompt file')
        return parser.parse_args()

class FileReader:
    """Handles reading plan and prompt files, combining them with lock removal instruction."""

    def read(self, plan_path, prompt_path):
        """Read contents of plan and prompt files, combine them, and append lock removal instruction."""
        try:
            with open(plan_path, 'r') as f:
                plan_content = f.read()
        except FileNotFoundError:
            raise FileNotFoundError(f"Plan file not found: {plan_path}")

        try:
            with open(prompt_path, 'r') as f:
                prompt_content = f.read()
        except FileNotFoundError:
            prompt_content = """Execute the plan in .cyclon.plan.md according to the checkboxes.

Each run:
- Check what has been completed and start from the first uncompleted checkbox.
- Execute exactly one uncompleted checkbox task from the plan.
- Do not perform multiple tasks or any additional work beyond that single checkbox.
- At the end of each execution, mark the completed checkbox in the file."""

        context_instruction = "\n\nIf .cyclon.context.md exists, read it for context on previous errors and project structure. After encountering errors or issues, compress and append relevant information to .cyclon.context.md for future runs."
        lock_instruction = "\n\nAfter completing all steps in the plan, remove the .cyclon.lock file."
        return f"{plan_content}\n\n{prompt_content}{context_instruction}{lock_instruction}"

class ExceptionChecker:
    """Checks if stderr output contains any predefined exception strings."""

    def __init__(self, exception_strings):
        """Initialize with list of exception strings."""
        self.exception_strings = exception_strings

    def check(self, stderr_output):
        """Check if any exception string is present in stderr_output."""
        for exc_str in self.exception_strings:
            if exc_str.strip() in stderr_output:
                return True
        return False

class OpencodeRunner:
    """Handles running opencode commands in a loop, checking lock file existence."""

    def __init__(self, config, exception_checker):
        """Initialize with config and exception checker."""
        self.config = config
        self.exception_checker = exception_checker
        self.lock_file = '.cyclon.lock'

    def run_loop(self, full_prompt):
        """Run the opencode command in a loop with error handling, exiting if lock file is removed."""
        print(f"Starting opencode loop with model: {self.config.model}")
        print(f"Plan file: {self.config.default_plan}")
        print(f"Prompt file: {self.config.default_prompt}")
        print(f"Sleep duration: {self.config.sleep_duration}s")

        while True:
            if not os.path.exists(self.lock_file):
                print("Lock file removed. Stopping loop.")
                break
            proc = None
            try:
                proc = subprocess.Popen(
                    ["opencode", "run", "--model", self.config.model, full_prompt],
                    stdin=sys.stdin,
                    stdout=sys.stdout,
                    stderr=subprocess.PIPE,
                    text=True
                )
                proc.wait(timeout=self.config.timeout)
                if proc.returncode != 0:
                    stderr_output = proc.stderr.read() if proc.stderr else ""
                    print(f"Opencode failed with return code {proc.returncode}")
                    print(f"Stderr: {stderr_output}")
                    if self.exception_checker.check(stderr_output):
                        print(f"Exception matched, sleeping for {self.config.sleep_duration} seconds...")
                        time.sleep(self.config.sleep_duration)
                        continue
                    else:
                        print("Unmatched error, stopping.")
                        break
                else:
                    print("Opencode completed successfully.")
                    print("Iteration complete, proceeding to next.")
            except subprocess.TimeoutExpired:
                print("Opencode timed out.")
                if proc:
                    proc.kill()
                break
            except FileNotFoundError:
                print("Opencode command not found. Ensure opencode is installed and in PATH.")
                break
            except KeyboardInterrupt:
                print("Interrupted by user.")
                break

            # Sleep only if continuing due to exception, otherwise proceed immediately

        print("Script finished.")

def main():
    """Main entry point of the script. Creates lock file and starts the loop."""
    lock_file = '.cyclon.lock'
    if os.path.exists(lock_file):
        print("Lock file exists. Continuing from previous session.")
    # Create/overwrite lock file
    with open(lock_file, 'w') as f:
        f.write('')

    config = Config()
    arg_parser = ArgumentParser(config)
    args = arg_parser.parse()
    file_reader = FileReader()
    try:
        full_prompt = file_reader.read(args.plan, args.prompt)
    except FileNotFoundError as e:
        print(f"Error: {e}")
        sys.exit(1)
    exception_checker = ExceptionChecker(config.exception_strings)
    runner = OpencodeRunner(config, exception_checker)
    runner.run_loop(full_prompt)

    # Clean up context file after successful run
    context_file = '.cyclon.context.md'
    if os.path.exists(context_file):
        os.remove(context_file)
        print("Removed context file.")

if __name__ == "__main__":
    main()
